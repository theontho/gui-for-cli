    "The command was cancelled before it finished. Partial output may have been produced.": {
      "comment": "Terminal tab status summary.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُلغي الأمر قبل أن يكتمل. ربما نتجت مخرجات جزئية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কমান্ডটি শেষ হওয়ার আগেই বাতিল করা হয়েছে। আংশিক আউটপুট তৈরি হয়ে থাকতে পারে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Befehl wurde vor dem Abschluss abgebrochen. Möglicherweise wurde eine unvollständige Ausgabe erzeugt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El comando se canceló antes de terminar. Es posible que se haya generado una salida parcial."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فرمان پیش از پایان لغو شد. ممکن است خروجی ناقصی تولید شده باشد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Komento peruutettiin ennen kuin se valmistui. Osittaista tulostetta on voinut syntyä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La commande a été annulée avant la fin. Une sortie partielle a pu être produite."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפקודה בוטלה לפני שהסתיימה. ייתכן שנוצר פלט חלקי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कमांड पूरा होने से पहले रद्द कर दिया गया। आंशिक आउटपुट बना हो सकता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il comando è stato annullato prima di terminare. Potrebbe essere stato prodotto un output parziale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンドは完了前にキャンセルされました。一部の出力が生成されている可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명령이 완료되기 전에 취소되었습니다. 일부 출력이 생성되었을 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opdracht is geannuleerd voordat deze klaar was. Mogelijk is er gedeeltelijke uitvoer gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Polecenie zostało anulowane przed zakończeniem. Mogły powstać częściowe dane wyjściowe."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O comando foi cancelado antes de terminar. Uma saída parcial pode ter sido gerada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Команда была отменена до завершения. Возможно, был получен частичный вывод."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommandot avbröts innan det var klart. Delvis utdata kan ha skapats."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Команду скасовано до завершення. Можливо, було отримано частковий вивід."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کمانڈ مکمل ہونے سے پہلے منسوخ کر دی گئی۔ ہو سکتا ہے جزوی آؤٹ پٹ بن گیا ہو۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "命令在完成前已取消。可能已生成部分输出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "指令在完成前已取消，可能已產生部分輸出。"
          }
        }
      }
    },
    "The command was stopped by a signal before it finished.": {
      "comment": "Terminal tab status summary for a signal death.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُوقف الأمر بإشارة قبل أن يكتمل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কমান্ডটি শেষ হওয়ার আগেই একটি সিগন্যালের মাধ্যমে বন্ধ করা হয়েছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Befehl wurde vor dem Abschluss durch ein Signal gestoppt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El comando se detuvo por una señal antes de terminar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فرمان پیش از پایان با یک سیگنال متوقف شد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Signaali pysäytti komennon ennen kuin se valmistui."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La commande a été arrêtée par un signal avant la fin."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפקודה נעצרה על ידי אות לפני שהסתיימה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कमांड पूरा होने से पहले एक सिग्नल द्वारा रोक दिया गया।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il comando è stato interrotto da un segnale prima di terminare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンドは完了前にシグナルによって停止されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명령이 완료되기 전에 시그널로 중지되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opdracht is door een signaal gestopt voordat deze klaar was."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Polecenie zostało zatrzymane sygnałem przed zakończeniem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O comando foi interrompido por um sinal antes de terminar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Команда была остановлена сигналом до завершения."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommandot stoppades av en signal innan det var klart."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Команду було зупинено сигналом до завершення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کمانڈ مکمل ہونے سے پہلے ایک سگنل کے ذریعے روک دی گئی۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "命令在完成前被信号停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "指令在完成前被訊號中止。"
          }
        }
      }
    },
    "This runs the bundle's uninstall steps, deletes everything %@ keeps in your Library (including downloaded reference genomes and settings stored in the app's workspace), and moves the app to the Trash. Files you saved elsewhere are kept.": {
      "comment": "Uninstall confirmation body; %@ is the bundle name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشغّل هذا خطوات إلغاء التثبيت الخاصة بالحزمة، ويحذف كل ما يحتفظ به %@ في مجلد Library (بما في ذلك الجينومات المرجعية التي تم تنزيلها والإعدادات المخزنة في مساحة عمل التطبيق)، وينقل التطبيق إلى سلة المهملات. يتم الاحتفاظ بالملفات التي حفظتها في أماكن أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি বান্ডলের আনইনস্টল ধাপগুলো চালাবে, আপনার Library-তে %@ যা কিছু রাখে সব মুছে ফেলবে (ডাউনলোড করা রেফারেন্স জিনোম এবং অ্যাপের ওয়ার্কস্পেসে রাখা সেটিংসসহ), এবং অ্যাপটিকে ট্র্যাশে সরিয়ে দেবে। অন্য কোথাও সংরক্ষণ করা ফাইলগুলো থেকে যাবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden die Deinstallationsschritte des Bundles ausgeführt, alles gelöscht, was %@ in deiner Library speichert (einschließlich heruntergeladener Referenzgenome und der im Arbeitsbereich der App gespeicherten Einstellungen), und die App in den Papierkorb verschoben. Dateien, die du an anderen Orten gespeichert hast, bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto ejecuta los pasos de desinstalación del paquete, elimina todo lo que %@ guarda en tu Biblioteca (incluidos los genomas de referencia descargados y los ajustes guardados en el espacio de trabajo de la app) y mueve la app a la Papelera. Los archivos que guardaste en otros lugares se conservan."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این کار مراحل حذف نصب بسته را اجرا می‌کند، هر آنچه %@ در Library شما نگه می‌دارد (از جمله ژنوم‌های مرجع دانلودشده و تنظیمات ذخیره‌شده در فضای کاری برنامه) را حذف می‌کند و برنامه را به سطل زباله منتقل می‌کند. فایل‌هایی که در جای دیگری ذخیره کرده‌اید حفظ می‌شوند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä suorittaa paketin poistovaiheet, poistaa kaiken, mitä %@ säilyttää Kirjasto-kansiossasi (mukaan lukien ladatut referenssigenomit ja sovelluksen työtilaan tallennetut asetukset), ja siirtää sovelluksen roskakoriin. Muualle tallentamasi tiedostot säilytetään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action exécute les étapes de désinstallation du bundle, supprime tout ce que %@ conserve dans votre bibliothèque (y compris les génomes de référence téléchargés et les réglages enregistrés dans l’espace de travail de l’app) et place l’app dans la Corbeille. Les fichiers que vous avez enregistrés ailleurs sont conservés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו מריצה את שלבי ההסרה של החבילה, מוחקת את כל מה ש-%@ שומר בספריית Library שלך (כולל גנומי ייחוס שהורדו והגדרות השמורות בסביבת העבודה של היישום), ומעבירה את היישום לפח. קבצים ששמרת במקומות אחרים נשמרים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह बंडल के अनइंस्टॉल चरण चलाता है, %@ आपकी Library में जो कुछ भी रखता है उसे हटा देता है (डाउनलोड किए गए संदर्भ जीनोम और ऐप के वर्कस्पेस में सहेजी गई सेटिंग्स सहित), और ऐप को ट्रैश में ले जाता है। आपने जो फ़ाइलें कहीं और सहेजी हैं, वे बनी रहती हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esegue i passaggi di disinstallazione del bundle, elimina tutto ciò che %@ conserva nella tua Libreria (inclusi i genomi di riferimento scaricati e le impostazioni salvate nello spazio di lavoro dell’app) e sposta l’app nel Cestino. I file salvati altrove vengono mantenuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バンドルのアンインストール手順を実行し、%@がライブラリに保存しているもの（ダウンロードした参照ゲノムやアプリのワークスペースに保存された設定を含む）をすべて削除して、アプリをゴミ箱に移動します。ほかの場所に保存したファイルは残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "번들의 제거 단계를 실행하고, %@이(가) 라이브러리에 보관하는 모든 항목(다운로드한 참조 유전체와 앱 작업 공간에 저장된 설정 포함)을 삭제한 다음 앱을 휴지통으로 옮깁니다. 다른 위치에 저장한 파일은 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee worden de verwijderstappen van de bundel uitgevoerd, wordt alles verwijderd wat %@ in je Bibliotheek bewaart (inclusief gedownloade referentiegenomen en instellingen in de werkruimte van de app) en wordt de app naar de prullenmand verplaatst. Bestanden die je elders hebt bewaard, blijven behouden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to wykonanie kroków dezinstalacji pakietu, usunięcie wszystkiego, co %@ przechowuje w Twojej bibliotece (w tym pobranych genomów referencyjnych i ustawień zapisanych w obszarze roboczym aplikacji), oraz przeniesienie aplikacji do Kosza. Pliki zapisane w innych miejscach zostaną zachowane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso executa as etapas de desinstalação do pacote, apaga tudo o que %@ mantém na sua Biblioteca (incluindo genomas de referência baixados e configurações salvas no espaço de trabalho do app) e move o app para o Lixo. Os arquivos que você salvou em outros lugares são mantidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будут выполнены шаги удаления пакета, удалено всё, что %@ хранит в вашей папке «Библиотеки» (включая загруженные референсные геномы и настройки в рабочей папке приложения), а приложение будет перемещено в Корзину. Файлы, сохранённые в других местах, останутся."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta kör paketets avinstallationssteg, raderar allt som %@ sparar i ditt bibliotek (inklusive nedladdade referensgenom och inställningar i appens arbetsyta) och flyttar appen till papperskorgen. Filer som du har sparat på andra ställen behålls."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Буде виконано кроки видалення пакета, видалено все, що %@ зберігає у вашій папці «Бібліотека» (зокрема завантажені референсні геноми та налаштування в робочій папці застосунку), а застосунок буде переміщено до Смітника. Файли, збережені в інших місцях, залишаться."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ بنڈل کے ان انسٹال مراحل چلاتا ہے، %@ آپ کے Library فولڈر میں جو کچھ رکھتا ہے وہ سب حذف کر دیتا ہے (بشمول ڈاؤن لوڈ شدہ حوالہ جاتی جینوم اور ایپ کی ورک اسپیس میں محفوظ ترتیبات)، اور ایپ کو ٹریش میں منتقل کر دیتا ہے۔ جو فائلیں آپ نے کہیں اور محفوظ کی ہیں وہ برقرار رہتی ہیں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将运行捆绑包的卸载步骤，删除 %@ 在你的资源库中保存的所有内容（包括已下载的参考基因组和保存在 App 工作区中的设置），并将 App 移到废纸篓。你保存在其他位置的文件会被保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會執行套件的解除安裝步驟，刪除 %@ 存放在你「資源庫」中的所有內容（包括已下載的參考基因體，以及儲存在 App 工作區中的設定），並將 App 移到垃圾桶。你存放在其他位置的檔案會保留。"
          }
        }
      }
    },
