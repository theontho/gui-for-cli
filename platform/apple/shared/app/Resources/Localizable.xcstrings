  "strings": {
    "%@ was cancelled.": {
      "comment": "Terminal tab status detail; %@ is the command.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُلغي %@."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ বাতিল করা হয়েছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde abgebrochen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se canceló %@."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ لغو شد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ peruutettiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a été annulé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ בוטל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ रद्द कर दिया गया।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è stato annullato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はキャンセルされました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 취소되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is geannuleerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ zostało anulowane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ foi cancelado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ отменена."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ avbröts."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ скасовано."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ منسوخ کر دی گئی۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已取消。"
          }
        }
      }
    },
    "%@ was terminated by signal %lld (%@).": {
      "comment": "Terminal tab status detail: command, signal number, signal name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إنهاء %1$@ بالإشارة %2$lld (%3$@)."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ সিগন্যাল %2$lld (%3$@) দ্বারা বন্ধ করা হয়েছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ wurde durch Signal %2$lld (%3$@) beendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ se terminó por la señal %2$lld (%3$@)."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ با سیگنال %2$lld (%3$@) خاتمه یافت."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ lopetettiin signaalilla %2$lld (%3$@)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a été arrêté par le signal %2$lld (%3$@)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ הופסק על ידי אות %2$lld (%3$@)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ को सिग्नल %2$lld (%3$@) द्वारा समाप्त किया गया।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ è stato terminato dal segnale %2$lld (%3$@)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ はシグナル %2$lld (%3$@) により終了しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@이(가) 시그널 %2$lld(%3$@)(으)로 종료되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is beëindigd door signaal %2$lld (%3$@)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ zostało zakończone sygnałem %2$lld (%3$@)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ foi encerrado pelo sinal %2$lld (%3$@)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ завершена сигналом %2$lld (%3$@)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ avslutades av signal %2$lld (%3$@)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ завершено сигналом %2$lld (%3$@)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ کو سگنل %2$lld (%3$@) کے ذریعے ختم کیا گیا۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 被信号 %2$lld (%3$@) 终止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 被訊號 %2$lld（%3$@）終止。"
          }
        }
      }
    },
